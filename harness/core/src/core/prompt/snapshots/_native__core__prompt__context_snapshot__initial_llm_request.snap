            ]
          }
        },
        {
          "name": "write_file",
          "description": "Create or overwrite a UTF-8 file.",
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
