              "running",
              "completed",
              "failed",
              "stopped",
              "orphaned"
            ]
          },
          "bytesWritten": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "processId",
          "status",
          "bytesWritten"
        ]
      }
    },
    {
      "name": "process_list",
      "programmatic_name": {
        "namespace": "process",
        "name": "list"
      },
      "description": "List background processes owned by this agent session and their current status.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "processes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "processId": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "running",
                    "completed",
                    "failed",
                    "stopped",
                    "orphaned"
                  ]
                },
                "exitCode": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "outputPath": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "processId",
                "command",
                "status",
                "exitCode",
                "outputPath"
              ]
            }
          }
        },
        "required": [
          "processes"
        ]
      }
    },
    {
      "name": "process_stop",
      "programmatic_name": {
        "namespace": "process",
        "name": "stop"
      },
      "description": "Stop a background process and its child process group.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "processId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "processId"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "processId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "stopped",
              "orphaned"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "processId",
          "status",
          "exitCode"
        ]
      }
    },
    {
      "name": "agents_list_configs",
      "programmatic_name": {
        "namespace": "agents",
        "name": "list_configs"
      },
      "description": "List available named configurations, sorted by name. Omit config_name when spawning a generic child that inherits this agent's configuration.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description"
              ]
            }
          }
        },
        "required": [
          "configs"
        ]
      }
    },
    {
      "name": "agents_list",
      "programmatic_name": {
        "namespace": "agents",
        "name": "list"
      },
      "description": "List admitted direct children in creation order. Provisional spawns are not listed.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "config_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pending_turn": {
                      "const": true
                    },
                    "status": {
                      "const": "running"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "name",
                    "pending_turn"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "config_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pending_turn": {
                      "const": false
                    },
                    "status": {
                      "const": "idle"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "name",
                    "pending_turn"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "config_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pending_turn": {
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "status": {
                      "const": "failed"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "name",
                    "pending_turn",
                    "error"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "agents"
        ]
      }
    },
    {
      "name": "agents_spawn",
      "programmatic_name": {
        "namespace": "agents",
        "name": "spawn"
      },
      "description": "Create an independent child with fresh conversation and admit its first message, without waiting for completion. name is a single path segment unique for the lifetime of this parent Session and cannot be reused. Omit config_name to inherit this agent's configuration.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[^/]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "config_name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "name",
          "message"
        ]
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "success"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "agents_send_message",
      "programmatic_name": {
        "namespace": "agents",
        "name": "send_message"
      },
      "description": "Send a message to an agent path. Admission does not imply consumption or a reply.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "agent_path",
          "message"
        ]
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "success"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "agents_interrupt",
      "programmatic_name": {
        "namespace": "agents",
        "name": "interrupt"
      },
      "description": "Interrupt a direct child's exact current Turn without closing its Session.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "success"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  ]
}
