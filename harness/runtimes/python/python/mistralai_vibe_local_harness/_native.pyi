class HarnessSession:
    @staticmethod
    def create(
        config_json: str,
        initial_history_json: str,
        conversation_json: str | None = None,
    ) -> HarnessSession: ...
    @staticmethod
    def restore(
        config_json: str,
        checkpoint_json: str,
        resume_input_id: int = 0,
        moved_from_json: str | None = None,
    ) -> HarnessSession: ...
    def apply(self, input_json: str) -> str: ...
    def inspect(self) -> str: ...
    def checkpoint(self) -> str: ...
    def export_conversation(self, context: str) -> str: ...
    def close(self) -> None: ...
