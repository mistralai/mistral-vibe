def restored_bash_call(
    arguments_json: str, *, bash_timeout_json: str | None
) -> tuple[str | None, str | None]: ...
def hook_tool_catalog(config_json: str) -> str: ...
def process_tools_timeout_advice(
    *, background_processes: bool, command_environment: str
) -> str | None: ...
def process_tools_shell_guidance(
    *, background_processes: bool, command_environment: str
