#vibecodeprojectcreate-app {
    width: 100%;
    height: auto;
    background: transparent;
    border: solid $foreground-muted;
    padding: 0 1;
    margin: 0;
}

#vibecodeprojectcreate-content {
    width: 100%;
    height: auto;
}

.vibecodeprojectcreate-title {
    height: auto;
    text-style: bold;
    color: $primary;
}

.vibecodeprojectcreate-repo {
    width: 100%;
    height: auto;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 1;
}

.vibecodeprojectcreate-input-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.vibecodeprojectcreate-input-label {
    width: 15;
    height: auto;
    color: $text-muted;
    margin-right: 1;

    &:ansi {
        text-style: dim;
    }
}

#vibecodeprojectcreate-name,
#vibecodeprojectcreate-default-branch {
    width: 1fr;
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

.vibecodeprojectcreate-help {
    width: 100%;
    height: auto;
    color: $text-muted;
