/* Debug Console */

#debug-console {
    dock: right;
    width: 40%;
    max-width: 80;
    min-width: 40;
    height: 100%;
    background: transparent;
    border-left: solid $foreground-muted;
    padding: 0 1;
}

#debug-console-header {
    width: 100%;
    height: auto;
    color: $foreground;
    padding: 0 0 1 0;
    text-align: left;
}

#debug-console-log {
    width: 100%;
    height: 1fr;
    background: transparent;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

