#vibecodeprojectpicker-search {
    width: 1fr;
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

#vibecodeprojectpicker-options {
    width: 100%;
    max-height: 50vh;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
}

#vibecodeprojectpicker-options:focus {
